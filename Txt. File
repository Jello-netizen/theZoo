$TargetFolder = "$env:USERPROFILE\Desktop\RansomTest"
$RansomNote = "$TargetFolder\README_RESTORE_FILES.txt"

# Create test folder and files
if (!(Test-Path $TargetFolder)) {
    New-Item -ItemType Directory -Path $TargetFolder | Out-Null
    1..5 | ForEach-Object {
        Set-Content -Path "$TargetFolder\TestFile$_.txt" -Value "This is test file $_"
    }
}

# Simulate "encryption" by renaming files
Get-ChildItem -Path $TargetFolder -Filter "*.txt" | ForEach-Object {
    Rename-Item $_.FullName ($_.Name + ".locked")
}

# Drop fake ransom note
